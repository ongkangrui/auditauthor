FROM python:3.11-slim
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps .
EXPOSE 8501
CMD ["streamlit", "run", "src/auditauthor/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.maxUploadSize=20", "--browser.gatherUsageStats=false"]
